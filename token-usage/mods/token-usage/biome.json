{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" } },
  "linter": {
    "rules": {
      "style": { "useNodejsImportProtocol": "off" },
      "suspicious": { "noTemplateCurlyInString": "off" }
    }
  }
}
