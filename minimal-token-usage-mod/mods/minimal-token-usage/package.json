{
  "name": "minimal-token-usage",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/stamp-generated.mjs",
    "mirror": "node scripts/mirror.mjs",
    "test": "npm run build && npm run mirror && node --test tests/*.test.js ../../tests/*.test.js",
    "verify": "npm run typecheck && npm test && npm run lint && herdr-app check .",
    "pretypecheck": "node scripts/ensure-host-types.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/lint.mjs --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "7.0.2"
  }
}
